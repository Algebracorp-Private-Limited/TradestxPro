# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / Railway).
DATABASE_URL=postgres://user:password@host:5432/tradestxpro?sslmode=require

# Email OTP delivery via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
EMAIL_FROM="TradestXPro <no-reply@yourdomain.com>"
