# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / Railway).
DATABASE_URL=postgres://user:password@host:5432/tradestxpro?sslmode=require

# Email OTP delivery via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
EMAIL_FROM="TradestXPro <no-reply@yourdomain.com>"

# Encrypts broker API keys and session tokens (any random string of 32+ characters). Required for Broker Connect.
BROKER_ENC_KEY=

# Comma-separated emails that can open /admin/waitlist.
ADMIN_EMAILS=

# Optional platform apps for redirect-login brokers (leave empty to keep them disabled):
KITE_API_KEY=
KITE_API_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
FYERS_APP_ID=
FYERS_SECRET=
ANGEL_API_KEY=
